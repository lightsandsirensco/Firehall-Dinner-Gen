# Copy to .env and fill in values

# Admin API (/api/admin/*) — required for /admin pages and dev-only test routes
ADMIN_SECRET=
# Optional local dev: mirrors ADMIN_SECRET for admin UI (visible in client bundle — dev only)
# VITE_ADMIN_SECRET=

# Reverse proxy hops for rate limits (1 behind nginx/caddy in prod; false for local-only)
# TRUST_PROXY_HOPS=1
# TRUST_PROXY_HOPS=false

# Max JSON body size for API POSTs (default 256kb)
# JSON_BODY_LIMIT=256kb

# Production HTTP logging: only API routes >= this ms (hero polls omitted)
# HTTP_SLOW_MS=800

OPENAI_API_KEY=
# Replit integrations (optional — if unset, OPENAI_API_KEY is used)
# AI_INTEGRATIONS_OPENAI_API_KEY=
# AI_INTEGRATIONS_OPENAI_BASE_URL=

# AI food imagery pipeline (curated + hall classics; publisher heroes preserved by default)
# FOOD_IMAGERY_ENABLED=true   # REQUIRED — pipeline is off unless this is exactly "true"
# FOOD_IMAGERY_MODEL=gpt-image-1
# FOOD_IMAGERY_SIZE=1024x1024  # also: 1024x1536, 1536x1024, auto (512x512 is remapped)
# FOOD_IMAGERY_MAX_CONCURRENT=2
# FOOD_IMAGERY_MAX_RETRIES=2
# FOOD_IMAGERY_VISION_VALIDATE=false
# FOOD_IMAGERY_VISION_MODEL=gpt-4o-mini
# FOOD_IMAGERY_REPLACE_SPOONACULAR=true
# FOOD_IMAGERY_PRESERVE_PUBLISHER=true
# FOOD_IMAGERY_STORAGE_DIR=client/public/images/generated
# Production (Replit): auto-uses dist/public/images/generated when NODE_ENV=production

# Editorial Golden 100 pipeline — CDN + vision QA
# EDITORIAL_CDN_BASE_URL=https://cdn.firehallmeals.com
# VITE_EDITORIAL_CDN_BASE_URL=https://cdn.firehallmeals.com
# npm install sharp  — true mobile/thumb/rail crops, WebP, LQIP (without sharp: copies hero to all paths)
# PUBLIC_APP_URL=https://your-repl-domain  # optional — Replit sets REPLIT_DOMAINS automatically
SPOONACULAR_API_KEY=
# Local dev only (Windows TLS / corporate proxy):
# - SPOONACULAR_INSECURE_TLS=true enables a scoped dev-only TLS dispatcher for Spoonacular fetches.
# - If your network still breaks TLS, set SPOONACULAR_TLS_FALLBACK_GLOBAL=true to also set NODE_TLS_REJECT_UNAUTHORIZED=0
#   (emergency only; never in production).
# SPOONACULAR_INSECURE_TLS=true
# SPOONACULAR_TLS_FALLBACK_GLOBAL=true
# SPOONACULAR_TIMEOUT_MS=15000
# SPOONACULAR_RETRY_MAX=3
# Local Windows TLS fix for OpenAI only (dev) — never use in production
# OPENAI_INSECURE_TLS=true
KLAVIYO_API_KEY=

# Pinterest trend discovery (Apify)
APIFY_API_TOKEN=
# Optional: actor id (default pear_fight~pinterest-scraper)
# APIFY_PINTEREST_ACTOR_ID=pear_fight~pinterest-scraper
# Re-use existing run output instead of starting a new actor:
# APIFY_DATASET_ID=
# APIFY_ACTOR_RUN_ID=
# INGEST_TREND_SIGNALS_PATH=./data/ingestion/trend-signals.json
# INGEST_SKIP_APIFY_RUN=true   # use trend-signals.json / APIFY_DATASET_ID only

# Verbose server diagnostics (filter dumps, candidate tries, raw AI snippets)
# Production: leave unset or false
DEBUG_LOGS=false

# Emergency only: allow LLM remix when AI validation exhausts (default: deterministic templates)
# ALLOW_LLM_FALLBACK=true

# When true, skip template fallback entirely (generate/explore return empty/503 instead)
# DISABLE_TEMPLATE_FALLBACK=true
